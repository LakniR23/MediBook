// Prisma Schema for MediBook

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Doctor {
  id           String        @id @default(uuid())
  name         String
  specialty    String
  email        String?
  phone        String?
  shift        String?       @default("Morning")
  room         String?       @default("Consult Room 01")
  appointments Appointment[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Appointment {
  id              String   @id @default(uuid())
  patientName     String
  patientContact  String?
  doctorId        String
  doctor          Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointmentDate DateTime // Stored in UTC
  appointmentType String   @default("CHECKUP")   // CHECKUP, CONSULTATION, FOLLOW_UP, ROUTINE_EXAM, EMERGENCY
  status          String   @default("SCHEDULED") // SCHEDULED, CONFIRMED, COMPLETED, CANCELLED, NO_SHOW
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientName])
  @@index([doctorId])
  @@index([appointmentDate])
  @@index([status])
}

model Patient {
  id            String   @id @default(uuid())
  mrn           String   @unique
  name          String
  age           Int      @default(35)
  gender        String   @default("Male")
  phone         String?
  email         String?
  bloodGroup    String   @default("O+")
  primaryDoctor String   @default("Dr. Silva")
  status        String   @default("ACTIVE") // ACTIVE, CHRONIC_CARE, DISCHARGED
  address       String?
  alertNote     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([mrn])
  @@index([name])
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phoneNumber  String?
  passwordHash String
  role         String   @default("Nurse") // Nurse, Doctor, Receptionist, Medical Officer, Admin
  station      String?  @default("General Ward")
  slmcReg      String?
  hospital     String?  @default("National Hospital of Sri Lanka")
  bio          String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@index([phoneNumber])
}
